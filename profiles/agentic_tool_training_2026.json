      },
      "tool": {
        "checks": [
          "tool_schema_valid",
          "argument_exactness",
          "state_update_consistent",
          "task_outcome_passed"
        ],
        "enabled": true,
        "export": "tool_rlvr.jsonl",
        "reward_axes": [
          "tool_schema_valid",
          "argument_exactness",
          "state_update_consistency",
          "task_outcome"
        ]
