  "posttraining_sequence": [
    {
      "algorithm": "sft",
      "id": "tool_sft_cold_start",
      "input": "tool_sft.jsonl",
      "purpose": "Teach valid tool-call syntax, state narration, MCP/server-manager style planning, and assistant-only loss."
    },
    {
      "algorithm": "reward",
      "id": "tool_reward_model",
      "input": "tool_reward.jsonl",
      "purpose": "Train tool/process/outcome rewards over state updates, terminal results, MCP claims, safety, and artifact quality."
    },
    {
      "algorithm": "dpo_orpo_kto_simpo",
      "id": "tool_preference_optimization",
      "input": "tool_preference.jsonl",
      "purpose": "Prefer valid, minimal, state-aware tool use over no-call, wrong-call, unsafe-call, and over-call behavior."
    },
    {
      "algorithm": "grpo_rloo",
      "id": "tool_rlvr_grpo",
      "input": "tool_rlvr.jsonl",
      "purpose": "Use verifiable rewards for BFCL, tau, MCPMark, terminal/container tasks, code tests, and multimodal tool artifacts."
    },
    {
      "algorithm": "grpo_rloo",
      "id": "math_rlvr_grpo",
      "input": "math_rlvr.jsonl",
      "purpose": "Train answer-verifiable math and symbolic-reasoning rollouts with no benchmark answer-key leakage."
    },
    {
      "algorithm": "grpo_rloo",
      "id": "code_rlvr_grpo",
      "input": "code_rlvr.jsonl",
      "purpose": "Train code repair and repository task rollouts against unit-test, patch-application, and runtime-safety rewards."
    },
    {
      "algorithm": "grpo_rloo",
      "id": "terminal_rlvr_grpo",
      "input": "terminal_rlvr.jsonl",
      "purpose": "Train shell, container, deployment, and recovery rollouts against exit-code, stdout, and filesystem-state rewards."
    },
    {
      "algorithm": "grpo_rloo",
      "id": "browser_rlvr_grpo",
      "input": "browser_rlvr.jsonl",
      "purpose": "Train browser/research/citation tasks with evidence support, freshness, and reached-page-state rewards."
    },
    {
      "algorithm": "kto_or_safety_sft",
      "id": "tool_safety_negative_alignment",
      "input": "tool_safety_negatives.jsonl",
      "purpose": "Penalize credential exposure, protected evaluation leakage, destructive actions, and prompt-injection obedience."
    },
    {
      "algorithm": "dapo_dr_grpo_lspo",
      "id": "tool_dapo_stability",
      "input": "tool_rlvr.jsonl",
      "purpose": "Stabilize long tool rollouts with dynamic sampling, length tracking, and overlong shaping."
    },
    {
      "algorithm": "retool_toolrl_cispo",
      "id": "browser_research_rlvr",
      "input": "tool_rlvr.jsonl",
      "purpose": "Train browser/retrieval/citation tasks with exact-answer and evidence rewards."
    },
    {
      "algorithm": "agentprm",
      "id": "agent_process_reward_model",
      "input": "tool_reward.jsonl",
      "purpose": "Train step-level process rewards for tool planning, correction, and reranking."
    }
  ],
  "profile_name": "agentic_tool_training_2026",
