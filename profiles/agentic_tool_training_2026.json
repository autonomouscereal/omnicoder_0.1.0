          "patch_applies",
          "no_forbidden_dependency"
        ],
        "enabled": true,
        "export": "code_rlvr.jsonl",
        "reward_axes": [
          "code_tests_passed",
          "minimal_patch",
          "runtime_safety",
          "style_consistency"
        ]
      },
      "math": {
        "checks": [
          "final_answer_exact",
          "symbolic_equivalence",
          "numeric_tolerance",
          "no_answer_key_leak"
        ],
        "enabled": true,
        "export": "math_rlvr.jsonl",
        "reward_axes": [
          "math_answer_exact",
          "reasoning_step_validity",
          "format_compliance"
        ]
      },
      "terminal": {
        "checks": [
          "exit_code_zero",
          "stdout_matches",
          "filesystem_state_matches",
          "no_destructive_unapproved_action"
