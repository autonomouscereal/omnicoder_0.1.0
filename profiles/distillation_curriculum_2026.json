{
  "job_plan": {
    "emit_per_teacher_files": true,
    "include_eval_holdout": false,
    "min_quality": 0.35,
    "per_teacher_limit": 512,
    "skip_contaminated": true,
    "skip_secret_rejected": true
  },
  "on_policy_distillation_2026": {
    "enabled": true,
    "methods": [
      "teacher_validated_disagreement_focusing",
      "reverse_kl_token_distill",
      "q4_consistency_distill"
    ],
    "prioritize": [
      "student_teacher_disagreement",
      "teacher_reliable",
      "verifier_failed_but_repairable"
    ],
    "targets": [
      "video_temporal_grounding",
      "audio_video_sync",
      "image_edit_preservation",
      "tool_repair",
      "long_context_compression",
      "mcp_state_recovery"
    ]
  },
  "posttraining": {
    "base_model": "Qwen/Qwen3-4B",
    "context_length": 1048576,
    "quantization_target": "q4",
    "stages": [
      {
        "algorithm": "sft",
        "bridge": "sft_qlora_2026",
        "dataset": "sft_jsonl",
        "id": "sft_cold_start",
        "purpose": "Format, tool schema, trace following, first-pass omnimodal instruction behavior."
      },
      {
        "algorithm": "multi_teacher_distillation",
        "dataset": "distillation_jobs",
        "id": "teacher_critique_distill",
        "purpose": "Collect corrected answers, critiques, verifier labels, preference pairs, and modal plans."
      },
      {
        "algorithm": "reward_model",
        "bridge": "posttrain_bridge_2026",
        "dataset": "teacher_reward_labels",
        "id": "reward_modeling",
        "purpose": "Train process/outcome rewards for code, tool use, image/video/audio quality, safety, and contamination."
      },
      {
        "algorithm": "dpo_orpo_kto_simpo",
        "bridge": "posttrain_bridge_2026",
        "dataset": "preference_pairs",
        "id": "preference_optimization",
        "purpose": "Align answers and tool behavior before on-policy RL."
      },
      {
        "algorithm": "grpo_dapo_tree_grpo",
        "bridge": "posttrain_bridge_2026",
        "dataset": "verifiable_env_rollouts",
        "id": "rlvr_agentic",
        "purpose": "Use verifiable rewards for code tests, terminal tasks, tool state, ARC-like worlds, and multimodal judges."
      },
      {
        "algorithm": "video_opd_distribution_matching",
        "bridge": "posttrain_bridge_2026",
        "dataset": "image_video_audio_teacher_rollouts",
        "id": "on_policy_multimodal_distill",
        "purpose": "Reduce train/inference mismatch for image/video/audio/music outputs."
      },
      {
        "algorithm": "long_context_sft_plus_rlvr",
        "dataset": "million_context_traces",
        "id": "long_context_retention",
        "purpose": "Native 1M context curriculum with retrieval-free trace retention and compression rewards."
      },
      {
        "algorithm": "qat_fake_quant_distill",
        "dataset": "mixed_sft_preference_rl",
        "id": "quantization_aware_recovery",
        "purpose": "Recover quality under q4 deployment with teacher-logit/answer consistency and verifier rewards."
      },
      {
        "algorithm": "browsecomp_style_grpo_rlvr",
        "bridge": "posttrain_bridge_2026",
        "dataset": "browser_research_agents",
        "id": "browser_research_rlvr",
        "purpose": "Train persistent web/tool search, citation support, uncertainty calibration, and answer-key isolation."
      },
      {
        "algorithm": "osworld_screenspot_process_reward",
        "bridge": "posttrain_bridge_2026",
        "dataset": "desktop_gui_agent_traces",
        "id": "desktop_gui_agent_rl",
        "purpose": "Train screen grounding, state drift control, and tool/action correctness."
      },
      {
        "algorithm": "avgen_vidaudio_rlaif_v",
        "bridge": "posttrain_bridge_2026",
        "dataset": "joint_audio_video_generation",
        "id": "audio_video_generation_alignment",
        "purpose": "Train text-to-audio-video, video-to-audio, speech/singing/music consistency, and perceptual-quality rewards."
      },
      {
        "algorithm": "turboquant_kv_qat_probe",
        "bridge": "posttrain_bridge_2026",
        "dataset": "long_context_1m",
        "id": "turboquant_kv_recovery",
        "purpose": "Preserve retrieval/agent quality under q4 weights plus q3.5/q4 KV compression for 1M context."
      },
      {
        "algorithm": "lean4_satp_rlvr",
        "bridge": "posttrain_bridge_2026",
        "dataset": "numinamath_lean_satp_and_deepseek_proverbench_filtered",
        "id": "formal_math_rlvr",
        "purpose": "Train formal theorem proving and tactic-state rewards without benchmark leakage."
      },
      {
        "algorithm": "kernelbench_cuda_triton_grpo",
        "bridge": "posttrain_bridge_2026",
        "dataset": "kernelbench_tritonbench_ai_cuda_engineer",
        "id": "cuda_kernel_rlvr",
        "purpose": "Train correctness plus speedup rewards for CUDA/Triton kernel generation on GPU sidecars."
      },
      {
        "algorithm": "state_action_next_state_distillation",
        "bridge": "posttrain_bridge_2026",
        "dataset": "qwen_webworlddata_browsergym_agent_traces",
        "id": "web_world_model_distill",
        "purpose": "Train browser state prediction, robust tool recovery, and long-horizon web-agent planning."
      },
      {
        "algorithm": "agent_lightning_style_async_grpo",
        "bridge": "posttrain_bridge_2026",
        "dataset": "mcp_universe_mcpmark_codex_claude_tool_traces",
        "id": "mcp_environment_rl",
        "purpose": "Train stateful MCP/browser/terminal tool recovery with poisoned-tool negatives and successful-eval trace quarantine."
      }
    ],
    "student_profile": "dense_omni_24gb"
  },
