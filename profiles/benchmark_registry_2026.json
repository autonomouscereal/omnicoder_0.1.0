{
  "version": "2026-05-23",
  "storage": "raw_postgresql_only",
  "schema": "schemas/eval_harness_2026.sql",
  "task_contract": {
    "required_fields": [
      "input_bundle",
      "allowed_tools",
      "environment_snapshot",
      "budget",
      "oracle",
      "scorer",
      "artifacts",
      "contamination_class"
    ]
  },
  "adapters": [
    {
      "id": "arc_agi3",
      "kind": "interactive_env",
      "source": "https://arcprize.org/arc-agi/3",
      "use": "interactive reasoning, exploration, adaptive world modeling",
      "smoke": "public_one_env",
      "reportable_split": "authorized_private",
      "holdout": [
        "private_envs",
        "solution_traces",
        "action_policies"
      ]
    },
    {
      "id": "swe_bench_pro",
      "kind": "long_horizon_git_container_patch",
      "source": "https://scale.com/blog/swe-bench-pro",
      "use": "repository-scale software engineering",
      "smoke": "public_dev_gold_patch",
      "holdout": [
        "hidden_tests",
        "gold_patches",
        "commercial_set",
        "heldout_set"
      ]
    },
    {
      "id": "swe_bench_live",
      "kind": "fresh_git_container_patch",
      "source": "https://arxiv.org/abs/2505.23419",
      "use": "contamination-resistant live code tasks",
      "smoke": "one_post_cutoff_problem",
      "holdout": [
        "future_tasks",
        "generated_tests",
        "accepted_patches"
      ]
    },
    {
      "id": "swe_bench_multimodal",
      "kind": "visual_issue_patch",
      "source": "registry_private_or_authorized",
      "use": "UI/image-bearing software tasks",
      "smoke": "asset_load",
      "holdout": [
        "screenshots",
        "visual_oracles",
        "gold_patches"
      ]
    },
    {
      "id": "terminal_bench_2",
      "kind": "harbor_container",
      "source": "https://arxiv.org/abs/2601.11868",
      "use": "terminal/container autonomy",
      "smoke": "oracle_container",
      "holdout": [
        "hidden_tests",
        "solutions",
        "successful_eval_transcripts"
      ]
    },
    {
      "id": "bfcl_v4",
      "kind": "tool_call_state_scorer",
      "source": "https://gorilla.cs.berkeley.edu/leaderboard.html",
      "use": "function and tool-call correctness",
      "smoke": "single_parallel_nested_multi_turn_non_call",
      "holdout": [
        "private_prompts",
        "expected_asts",
        "distractor_schemas"
      ]
    },
    {
      "id": "tau2_tau3",
      "kind": "simulated_user_tool_state",
      "source": "https://github.com/sierra-research/tau2-bench",
      "use": "policy-following stateful tool agents and voice",
      "smoke": "dual_control_fixed_task",
      "holdout": [
        "policies",
        "db_states",
        "simulator_scripts",
        "voice_samples"
      ]
    },
    {
      "id": "mcp_agent_suite",
      "kind": "mcp_fixture_adapter",
      "source": "https://github.com/eval-sys/mcpmark",
      "use": "real MCP server orchestration and claim-level scoring",
      "smoke": "filesystem_postgres_playwright_fixture",
      "holdout": [
        "seeded_workspaces",
        "expected_claims",
        "grading_rubrics"
      ]
    },
    {
      "id": "livecodebench",
      "kind": "date_filtered_code_runner",
      "source": "https://github.com/LiveCodeBench/LiveCodeBench",
      "use": "fresh coding skill",
      "smoke": "one_post_cutoff_problem",
      "holdout": [
        "future_split",
        "private_tests"
      ]
    },
    {
      "id": "mmmu_pro",
      "kind": "multimodal_mcq",
      "source": "current_official_release",
      "use": "expert image/text reasoning",
      "smoke": "standard_and_vision_only",
      "holdout": [
        "questions",
        "answers",
        "images"
      ]
    },
    {
      "id": "video_understanding",
      "kind": "media_understanding",
      "source": "Video-MME/LVOmniBench/JointAVBench current releases",
      "use": "long video, subtitle, audio-video temporal reasoning",
      "smoke": "short_long_with_without_subtitles",
      "holdout": [
        "videos",
        "subtitles",
        "answers",
        "audio_tracks"
      ]
    },
    {
      "id": "image_generation_edit",
      "kind": "media_generation",
      "source": "GenEval2/BizGenEval/CompBench/Pico-Banana-style private slices",
      "use": "image prompt adherence, text rendering, editing preservation",
      "smoke": "five_prompts_two_edits",
      "holdout": [
        "private_prompts",
        "human_labels",
        "judge_prompts"
      ]
    },
    {
      "id": "video_audio_music_tts",
      "kind": "media_generation",
      "source": "VBench/VBench++/AVGen/T2AV/AudioBench/AudioCapBench/Music Arena/Coval current releases",
      "use": "video/audio/music/TTS artifact quality and sync",
      "smoke": "no_black_no_corrupt_sync_probe",
      "holdout": [
        "private_prompts",
        "preference_labels",
        "failed_eval_traces"
      ]
    },
    {
      "id": "terminal_bench_core",
      "kind": "harbor_container",
      "source": "https://www.tbench.ai/leaderboard/terminal-bench/2.1",
      "use": "core terminal/container autonomy",
      "smoke": "three_public_core_tasks",
      "holdout": [
        "hidden_tests",
        "solutions"
      ]
    },
    {
      "id": "acebench",
      "kind": "agent_env_tool_eval",
      "source": "https://arxiv.org/abs/2501.12851",
      "use": "complex tool-agent state and recovery",
      "smoke": "three_public_env_tasks",
      "holdout": [
        "expected_actions",
        "simulator_oracles"
      ]
    },
    {
      "id": "browsecomp_zh",
      "kind": "browser_research_agent",
      "source": "https://openai.com/index/browsecomp/",
      "use": "Chinese browsing/search agent correctness",
      "smoke": "two_public_dev_questions",
      "holdout": [
        "answers",
        "successful_eval_traces"
      ]
    },
    {
      "id": "deepsearch",
      "kind": "browser_retrieval_agent",
      "source": "official_current_release_or_authorized_mirror",
      "use": "deep multi-hop web/retrieval search",
      "smoke": "two_deep_search_tasks",
      "holdout": [
        "answers",
        "source_lists"
      ]
    },
    {
      "id": "artifactsbench",
      "kind": "artifact_creation_agent",
      "source": "official_current_release_or_authorized_mirror",
      "use": "artifact creation and file integrity",
      "smoke": "three_artifact_tasks",
      "holdout": [
        "rubrics",
        "reference_artifacts"
      ]
    },
    {
      "id": "mrcr",
      "kind": "long_context_qa",
      "source": "https://huggingface.co/datasets/openai/mrcr",
      "use": "multi-round coreference at 32K-1M",
      "smoke": "length_bucket_probe",
      "holdout": [
        "answers"
      ]
    },
    {
      "id": "longcodebench",
      "kind": "repo_long_code",
      "source": "https://huggingface.co/papers/2505.07897",
      "use": "repo-scale long-code reasoning",
      "smoke": "one_repo_task",
      "holdout": [
        "hidden_tests",
        "gold_patches"
      ]
    },
    {
      "id": "qwen3_omni_eval",
      "kind": "omni_understanding",
      "source": "https://arxiv.org/abs/2509.17765",
      "use": "audio/audio-visual omni understanding",
      "smoke": "three_omni_tasks",
      "holdout": [
        "answers",
        "media_labels"
      ]
    },
    {
      "id": "cosmos_predict2_generation",
      "kind": "world_video_generation",
      "source": "https://research.nvidia.com/labs/cosmos-lab/cosmos-predict2/",
      "use": "physical world video generation",
      "smoke": "three_world_prompts",
      "holdout": [
        "judge_prompts",
        "human_labels"
      ]
    },
    {
      "id": "swe_lancer",
      "kind": "paid_freelance_software_task_eval",
      "source": "https://openai.com/index/swe-lancer/",
      "use": "economic-value weighted software engineering deliverables",
      "smoke": "one_public_or_synthetic_task",
      "holdout": [
        "gold_deliverables",
        "private_tests",
        "expert_scores"
      ]
    },
    {
      "id": "gdpval",
      "kind": "occupational_work_product_eval",
      "source": "https://openai.com/index/gdpval/",
      "use": "documents, spreadsheets, slides, code, and media work products",
      "smoke": "one_deliverable_task",
      "holdout": [
        "expert_rubrics",
        "reference_artifacts"
      ]
    },
    {
      "id": "hle_rolling_livebench",
      "kind": "rolling_expert_objective_eval",
      "source": "https://agi.safe.ai/",
      "use": "fresh expert reasoning and monthly contamination-resistant tasks",
      "smoke": "two_public_fresh_tasks",
      "holdout": [
        "answer_keys",
        "future_snapshots"
      ]
    },
    {
      "id": "mcp_universe",
      "kind": "mcp_server_universe_eval",
      "source": "https://github.com/SalesforceAIResearch/MCP-Universe",
      "use": "broad MCP server and multi-tool workflow execution",
      "smoke": "one_stateful_mcp_task",
      "holdout": [
        "expected_traces",
        "seeded_server_state"
      ]
    },
    {
      "id": "plan_rewardbench",
      "kind": "trajectory_reward_model_eval",
      "source": "https://github.com/wyy-1112/Plan-RewardBench",
      "use": "agent planning and process reward model evaluation",
      "smoke": "one_plan_pair",
      "holdout": [
        "preference_labels",
        "process_labels"
      ]
    },
    {
      "id": "multimodal_rewardbench2",
      "kind": "omni_reward_model_eval",
      "source": "https://github.com/facebookresearch/MMRB2",
      "use": "multimodal reward models for generation, reasoning, and safety",
      "smoke": "two_multimodal_preference_pairs",
      "holdout": [
        "preference_labels",
        "media_assets"
      ]
    },
    {
      "id": "longmemeval_v2_nolima",
      "kind": "long_memory_and_nonliteral_retrieval",
      "source": "https://github.com/xiaowu0162/LongMemEval-V2",
      "use": "long-term agent memory and 1M non-literal retrieval",
      "smoke": "two_length_bucket_tasks",
      "holdout": [
        "target_memories",
        "answers",
        "haystacks"
      ]
    },
    {
      "id": "opens2v_t2v_compbench",
      "kind": "identity_and_compositional_video_generation",
      "source": "https://github.com/PKU-YuanGroup/OpenS2V-Nexus",
      "use": "subject-to-video and compositional text-to-video generation",
      "smoke": "two_video_generation_prompts",
      "holdout": [
        "private_subjects",
        "judge_labels"
      ]
    },
    {
      "id": "complex_image_video_edit",
      "kind": "complex_edit_and_counterfactual_video_eval",
      "source": "https://github.com/llllly26/ComplexBench-Edit",
      "use": "complex image edits and counterfactual/impossible video prompts",
      "smoke": "one_edit_one_video_prompt",
      "holdout": [
        "target_images",
        "judge_labels"
      ]
    },
    {
      "id": "healthbench",
      "kind": "health_reliability_rubric_eval",
      "source": "https://openai.com/index/healthbench/",
      "use": "health safety, calibration, and worst-case reliability",
      "smoke": "one_public_health_conversation",
      "holdout": [
        "rubric_labels",
        "expert_scores"
      ]
    },
    {
      "id": "m3_long_video_memory",
      "kind": "multimodal_tool_memory_video_eval",
      "source": "https://arxiv.org/abs/2511.17729",
      "use": "multimodal MCP workflows, long video tool thinking, and memory QA",
      "smoke": "three_multimodal_agent_video_tasks",
      "holdout": [
        "expected_tool_traces",
        "clip_labels",
        "memory_targets"
      ]
    },
    {
      "id": "cfvbench",
      "kind": "fine_grained_video_understanding_eval",
      "source": "https://dl.acm.org/doi/abs/10.1145/3774904.3792726",
      "use": "fine-grained video QA and temporal reasoning",
      "smoke": "one_video_qa_task",
      "holdout": [
        "rubrics",
        "answers",
        "videos"
      ]
    }
  ],
  "release_gates": {
    "must_pass": [
      "no_credential_leakage",
      "no_destructive_out_of_sandbox_actions",
      "no_hidden_test_access",
      "no_benchmark_prompt_memorization_signal",
      "reproducible_run_logs"
    ],
    "coding": [
      "swe_bench_pro",
      "swe_bench_live",
      "terminal_bench_2",
      "longcodebench",
      "swe_lancer"
    ],
    "agent": [
      "bfcl_v4",
      "tau2_tau3",
      "mcp_agent_suite",
      "arc_agi3",
      "terminal_bench_core",
      "acebench",
      "browsecomp_zh",
      "deepsearch",
      "artifactsbench",
      "gdpval",
      "mcp_universe",
      "plan_rewardbench",
      "m3_long_video_memory"
    ],
    "omnimodal_reasoning": [
      "mmmu_pro",
      "video_understanding",
      "qwen3_omni_eval",
      "mrcr",
      "hle_rolling_livebench",
      "multimodal_rewardbench2",
      "longmemeval_v2_nolima",
      "cfvbench"
    ],
    "generation": [
      "image_generation_edit",
      "video_audio_music_tts",
      "cosmos_predict2_generation",
      "opens2v_t2v_compbench",
      "complex_image_video_edit",
      "healthbench"
    ]
  },
  "cycles": {
    "smoke": "20-50 tasks under 60 minutes",
    "nightly": "10-20 percent stratified slice plus one fresh/live task batch",
    "release": "full authorized suites plus locked blind private evals"
  },
  "contamination_controls": [
    "record_dataset_commit_or_revision",
    "record_docker_digest_and_scorer_commit",
    "separate_public_dev_from_reportable_eval",
    "never_expose_gold_patches_hidden_tests_or_answer_keys_to_agent",
    "hash_prompt_artifacts_and_outputs",
    "report_model_only_model_plus_agent_and_model_plus_agent_plus_tools_separately",
    "successful_eval_trajectories_go_to_quarantine_until_benchmark_retired"
  ]
}
