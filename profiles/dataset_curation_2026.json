{
  "schema": "omnicoder.dataset_curation_2026.v1",
  "profile_name": "dataset_curation_2026",
  "run_name": "trace_curation_codex_claude_hermes_agent_memory_2026",
  "source_date": "2026-05-23",
  "work_dir": "weights/data_factory/trace_orchestrator_2026",
  "jsonl_fallback_first": true,
  "trace_inputs": {
    "sources": [
      {
        "path": "data/raw/agent_memory_events_2026.jsonl",
        "harness": "agent_memory"
      },
      {
        "path": "data/raw/codex_traces_2026",
        "harness": "codex"
      },
      {
        "path": "data/raw/claude_traces_2026",
        "harness": "claude"
      },
      {
        "path": "data/raw/hermes_traces_2026",
        "harness": "hermes"
      }
    ],
    "patterns": [
      "*.jsonl"
    ],
    "exclude_substrings": [
      "\\.git\\",
      "\\__pycache__\\",
      "\\weights\\data_factory\\trace_orchestrator_2026\\"
    ]
  },
  "data": {
    "bucket": "agentic_trace_sft_2026",
    "split": "train",
    "limit": 0,
    "per_file_limit": 0
  },
  "curation_layers": {
    "require_2025_2026": true,
    "min_chars": 8,
    "dedupe": true,
    "fallback_when_module_missing": true
  },
  "quality": {
    "stage_min_score": 0.0,
    "export_min_quality": 0.35,
    "scorer": "heuristic_quality_v1"
  },
  "contamination": {
    "protected_path": "data/protected/eval_holdout_2026.jsonl",
    "threshold": 0.42,
    "ngram": 5
  },
  "export_sft": {
    "out": "weights/data_factory/trace_orchestrator_2026/exports/sft_traces.jsonl",
    "min_quality": 0.35,
    "allow_contaminated": false,
    "group_traces": true,
    "limit": 0
  },
  "teacher_jobs": {
    "enabled": true,
    "teacher": "qwen3.6_27b_q4_local",
    "job_type": "trace_critique",
    "limit": 512,
    "out": "weights/data_factory/trace_orchestrator_2026/teacher_jobs/teacher_jobs_2026.jsonl",
    "enqueue_postgres": false,
    "priority": 100
  },
  "postgres": {
    "enabled": false,
    "mode": "optional_raw_hooks",
    "namespace": "trace",
    "license": "internal",
    "fail_on_error": false,
    "notes": "JSONL curation is the default. Enable only after raw PostgreSQL schemas and environment credentials are configured."
  },
  "manifests": {
    "dataset_card": true,
    "artifact_manifest": true,
    "collected_files": true,
    "cleaned_dataset_manifest": "weights/training_orchestration_2026/manifests/cleaned_dataset_manifest.json",
    "source_files_manifest": "weights/training_orchestration_2026/manifests/source_files.jsonl",
    "dataset_blend_manifest": "weights/training_orchestration_2026/manifests/dataset_blend_manifest.json",
    "posttraining_curation_manifest": "weights/training_orchestration_2026/agentic_tool_training_2026/manifests/posttraining_curation_manifest.json"
  },
  "notes": [
    "Codex and agent-memory traces use dedicated ingest modules; Claude and Hermes traces use the generic 2026 trace normalizer until dedicated modules exist.",
    "The orchestrator attempts omnicoder.data_factory.curation_layers_2026 when present and otherwise applies the built-in 2025-2026 JSONL fallback curation layer.",
    "No ORM, Pydantic, SQLAlchemy, SQLite, or backup database path is used by this profile."
  ],
  "dataset_blends_2026": {
    "agentic_core": {
      "sources": [
        "codex_traces",
        "claude_traces",
        "hermes_traces",
        "agent_memory_events",
        "lmstudio_conversations"
      ],
      "target_fraction": 0.28,
      "filters": [
        "secret_scan",
        "tool_schema_valid",
        "outcome_or_observation_present",
        "no_eval_holdout_overlap"
      ]
    },
    "code_repair_security": {
      "sources": [
        "Multi-SWE-bench_dev",
        "SWE-Bench++_dev",
        "EVMbench_dev",
        "local_repo_issue_traces"
      ],
      "target_fraction": 0.18,
      "filters": [
        "license_allowlist",
        "hidden_tests_removed",
        "repo_commit_pinned",
        "patch_applies_or_negative_label"
      ]
    },
    "browser_research_agents": {
      "sources": [
        "synthetic_browsecomp_style_non_eval",
        "mm_browsecomp_style_non_eval",
        "paperbench_mini_internal",
        "mle_bench_lite_internal"
      ],
      "target_fraction": 0.12,
      "filters": [
        "answer_key_separate",
        "citation_required",
        "canary_filtered",
        "trajectory_quarantine_on_eval_success"
      ]
    },
    "image_video_audio_music": {
      "sources": [
        "qwen_image_outputs",
        "qwen_image_edit_outputs",
        "ltx_2_3_outputs",
        "ace_step_1_5_outputs",
        "comfyui_output_manifests"
      ],
      "target_fraction": 0.24,
      "filters": [
        "artifact_hash_present",
        "media_nonempty",
        "prompt_present",
        "quality_or_reward_label_present"
      ]
    },
    "long_context_1m": {
      "sources": [
        "repo_bundles",
        "multi_doc_bundles",
        "agent_session_bundles",
        "long_av_transcripts",
        "traceav_style_internal"
      ],
      "target_fraction": 0.18,
      "filters": [
        "length_bucketed",
        "needle_not_from_eval",
        "compression_summary_present",
        "kv_perf_metadata_when_available"
      ]
    }
  },
  "cleaning_layers_2026": [
    {
      "id": "raw_json_schema",
      "action": "reject_missing_payload_or_modality"
    },
    {
      "id": "secret_redaction",
      "action": "reject_or_mask_passwords_tokens_keys_before_export"
    },
    {
      "id": "license_allowlist",
      "action": "keep_internal_permissive_or_authorized_only"
    },
    {
      "id": "near_dedupe",
      "action": "sha256_exact_plus_5gram_similarity_threshold"
    },
    {
      "id": "benchmark_decontamination",
      "action": "compare_against_protected_eval_registry_and_canaries"
    },
    {
      "id": "artifact_validation",
      "action": "hash_media_byte_size_mime_and_probe_nonempty_media"
    },
    {
      "id": "quality_scoring",
      "action": "heuristic_plus_teacher_or_verifier_score_when_available"
    },
    {
      "id": "split_stratification",
      "action": "modality_source_length_and_quality_balanced_train_eval_test"
    }
  ],
  "reinforcement_exports_2026": {
    "export_dir": "weights/training_orchestration_2026/agentic_tool_training_2026",
