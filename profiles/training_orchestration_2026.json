  "training_plan": {
    "preset": "omnicoder2026_20b_1m",
    "distributed_training": {
      "mode": "pipeline_stage",
      "nproc_per_node": 3,
      "main_gpu_devices": [
        "0",
        "4",
        "6"
      ],
      "rank_device_map": [
        "0",
        "1",
        "2"
      ],
      "placement": "weighted_layers",
      "placement_devices": [
        "0",
        "1",
        "2"
      ],
      "placement_layer_counts": [
        16,
        16,
        32
      ],
      "placement_head_device": 2,
      "main_gpu_policy": "PipelineStage torchrun inside a container exposing host GPUs 0,4,6 only: container rank 0 maps to RTX 3090 with 16 layers, rank 1 maps to RTX 3090 with 16 layers, and rank 2 maps to RTX 8000 with 32 layers plus norm/output head. P40s stay out of the synchronous target path and run asynchronous sidecar jobs after the target path is stable.",
      "pipeline_stage_schedule": "gpipe",
      "pipeline_microbatches": 1,
      "precision": "fp16",
      "init_dtype": "fp16",
      "optimizer": "adafactor",
      "optimizer_in_backward": true,
      "optimizer_in_backward_update": "lowmem_adafactor",
      "optimizer_in_backward_grad_clip": 1.0,
      "optimizer_in_backward_clip_mode": "rms",
      "optimizer_in_backward_adafactor_chunk_rows": 256,
      "optimizer_in_backward_adafactor_clip_threshold": 1.0,
      "optimizer_in_backward_adafactor_decay_rate": -0.8,
      "optimizer_in_backward_adafactor_eps1": 1e-30,
      "activation_checkpointing": true,
      "cpu_offload": false,
      "fake_quant_chunk_rows": 64,
      "fake_quant_max_full_elements": 16777216,
      "checkpoint_format": "pipeline_stage_sharded_checkpoint_v2",
      "p40_sidecar_devices": [
        "1",
        "2",
        "3",
        "5"
      ],
      "p40_sidecar_roles": [
        "teacher/distillation batch generation",
        "curation media hashing and codec-token materialization",
        "short-context GGUF/llama.cpp compatibility checks",
        "probe-scale regression sweeps that must not block the target FSDP step"
      ]
    },
    "stage_order": [
      "text",
      "code",
      "tool",
      "image",
      "video",
      "audio",
      "music",
      "long_context"
    ],
    "required_modalities": [
      "text",
      "code",
      "tool",
      "image",
      "video",
      "audio",
      "music",
      "long_context"
    ],
    "max_records_per_modality": 256,
    "max_records_per_modality_by_modality": {
      "text": 768,
      "code": 768,
      "tool": 768,
      "long_context": 768,
      "audio": 768,
      "image": 128,
      "video": 128,
      "music": 128
    },
    "min_records_per_modality": 1,
    "steps_per_stage": 64,
    "save_interval": 32,
    "seq_len": 1024,
    "batch_size": 1,
    "learning_rate": 0.00002,
    "finetune_steps": 64,
    "finetune_learning_rate": 0.000005,
    "device": "cuda",
    "fake_quant": true,
    "fake_quant_chunk_rows": 64,
    "fake_quant_max_full_elements": 16777216,
    "resume_between_stages": true,
    "text_token_limit": 384,
    "target_text_chars": 3000,
    "heldout_sample_loss_max_records_per_file": 32,
    "heldout_sample_loss_timeout_seconds": 3600,
    "sample_loss_max_records_per_file": 32,
    "sample_loss_timeout_seconds": 3600,
    "max_text_file_bytes": 1048576,
    "fallback_token_count": 32,
    "max_hash_bytes": 268435456,
    "max_media_bytes": 536870912,
    "artifact_token_count": {
      "image": 64,
      "video": 64,
      "audio": 64,
      "music": 64,
      "tool": 48,
      "long_context": 48
    }
  },
  "gpu_utilization_sidecar": {
    "schema": "omnicoder.gpu_utilization_sidecar_2026.v1",
    "enabled": true,
    "launcher": "omnicoder.tools.gpu_sidecar_2026",
    "dispatch_policy": "detached_nonblocking_subprocesses",
    "devices": [
      "1",
      "2",
      "3",
      "5"
    ],
    "main_training_devices": [
      "0",
      "4",
      "6"
    ],
    "out_root": "weights/training_orchestration_2026/gpu_sidecar",
    "write_policy": "sidecar-only manifests/logs/artifacts; no writes to core trainer checkpoints",
    "max_active_per_device": 1,
    "omp_threads": 4,
    "env": {
      "PYTORCH_CUDA_ALLOC_CONF": "max_split_size_mb:128"
    },
    "jobs": [
      {
        "job_id": "p40_1_dataset_token_materialization",
        "job_type": "dataset_materialization",
        "device": "1",
        "enabled": true,
        "priority": 10
      },
      {
        "job_id": "p40_2_teacher_distillation_jobs",
        "job_type": "teacher_distillation",
        "device": "2",
        "enabled": true,
        "priority": 20,
        "records": "weights/curated_datasets_2026/latest/jsonl/train_tool.jsonl",
        "limit": 512,
        "skip_if_missing": [
          "weights/curated_datasets_2026/latest/jsonl/train_tool.jsonl"
        ]
      },
      {
        "job_id": "p40_3_eval_shard_latest_checkpoint",
        "job_type": "eval_shard",
        "device": "3",
        "enabled": true,
        "priority": 30,
        "checkpoint": "weights/training_orchestration_2026/checkpoints/08_long_context.pt",
        "data_dir": "weights/training_orchestration_2026/jsonl",
        "seq_len": 512,
        "max_records_per_file": 64,
        "skip_if_missing": [
          "weights/training_orchestration_2026/checkpoints/08_long_context.pt",
          "weights/training_orchestration_2026/jsonl"
        ]
      },
      {
        "job_id": "p40_5_probe_training_run",
        "job_type": "training_run",
        "device": "5",
        "enabled": true,
        "priority": 35,
        "stage": "run-real",
        "preset": "ledger_probe",
        "distributed": "none",
        "placement": "single",
        "precision": "fp16",
        "init_dtype": "fp16",
        "optimizer": "adafactor",
        "steps_per_stage": 4,
        "seq_len": 192,
        "batch_size": 1,
        "save_interval": 0,
        "fake_quant": true,
        "allow_verifier_preset": true
      },
      {
        "job_id": "p40_3_benchmark_canary",
        "job_type": "benchmark_canary",
        "device": "3",
        "enabled": true,
        "priority": 40,
        "model": "sidecar_probe_or_latest",
        "mode": "smoke",
        "cycle": "smoke",
        "timeout_seconds": 60
      }
    ]
  },
  "learning_checks": {
    "min_loss_points": 4,
    "min_relative_loss_drop": 0.0005,
    "fail_required_modality_on_missing_records": true,
    "emit_per_modality_loss_logs": true
  },
  "ai_server": {
    "server_id": "ai",
    "host_ref": "server-manager:ai",
    "scheduler": "raw_postgresql_claim_queue_with_jsonl_spool",
    "jsonl_spool_dir": "weights/training_orchestration_2026/spool",
    "artifact_root": "weights/training_orchestration_2026/artifacts",
    "max_concurrent_jobs": 2,
    "resource_pools": [
      {
        "pool_id": "gpu_training",
        "worker_selector": {
          "server": "ai",
          "accelerator": "cuda"
        },
        "max_active": 1,
        "job_types": [
          "sft",
          "distillation",
          "q4_recovery",
          "benchmark_gate"
        ]
      },
      {
        "pool_id": "comfyui_media",
        "worker_selector": {
          "server": "ai",
          "service": "comfyui"
        },
        "max_active": 1,
        "job_types": [
          "image_curation",
          "video_curation",
          "audio_curation",
          "music_curation",
          "multimodal_teacher"
        ]
      },
      {
        "pool_id": "cpu_jsonl_curation",
        "worker_selector": {
          "server": "local_or_ai",
          "accelerator": "cpu"
        },
        "max_active": 4,
        "job_types": [
          "jsonl_ingest",
          "dedupe",
          "hash_scan",
          "loss_trend_check"
        ]
      }
    ]
  },
  "record_contracts": {
    "jsonl_event_required_fields": [
      "event_id",
      "event_type",
      "event_time",
      "run_id",
      "stage_id",
      "record_id",
      "modality",
      "payload",
      "artifact_refs",
      "sha256"
    ],
    "training_record_required_fields": [
      "record_id",
      "source_id",
      "source_date",
      "modalities",
      "split",
      "quality_score",
      "contamination_status",
      "payload_sha256",
      "artifact_refs"
    ],
    "artifact_required_fields": [
      "artifact_id",
      "kind",
      "uri",
      "sha256",
      "byte_size",
      "mime_type",
      "created_at"
    ],
    "cleaned_dataset_manifest_required_fields": [
      "schema",
      "schema_version",
      "created_at",
      "status",
      "records",
      "modalities",
      "splits",
      "required_fields",
      "missing_required_field_counts",
      "contamination_status",
      "quality_score",
      "artifact_count",
      "source_file_count"
    ],
    "posttraining_export_required_fields": [
      "schema",
      "training_kind",
      "record_id",
      "source_record_id",
      "source_id",
      "modality",
      "quality_score",
      "contamination_status"
    ]
  },
  "modalities": {
    "text": {
      "enabled": true,
      "formats": [
        "instruction",
        "dialog",
        "reasoning_trace",
        "long_context_document"
      ],
      "min_quality": 0.35
    },
    "code": {
      "enabled": true,
      "formats": [
        "repo_patch",
        "terminal_trace",
        "test_result",
        "review_finding"
      ],
      "min_quality": 0.4
    },
    "tool": {
      "enabled": true,
      "formats": [
        "tool_schema",
        "tool_call_ast",
        "tool_observation",
        "state_delta",
        "trajectory"
      ],
      "min_quality": 0.4
    },
    "image": {
      "enabled": true,
      "formats": [
        "caption",
        "generation_prompt",
        "edit_plan",
        "critique",
        "reward_label"
      ],
      "min_quality": 0.38
    },
    "video": {
      "enabled": true,
      "formats": [
        "shot_plan",
        "temporal_caption",
        "image_to_video_plan",
        "sync_critique",
        "reward_label"
      ],
      "min_quality": 0.38
    },
    "audio": {
      "enabled": true,
      "formats": [
        "speech_caption",
        "audio_scene",
        "transcription",
        "alignment_label",
        "critique"
      ],
      "min_quality": 0.38
    },
    "music": {
      "enabled": true,
      "formats": [
        "music_plan",
        "lyrics_alignment",
        "style_label",
        "structure_label",
        "reward_label"
      ],
      "min_quality": 0.38
    },
    "long_context": {
      "enabled": true,
      "context_windows": [
        32768,
        131072,
        1048576,
        2097152
      ],
      "formats": [
        "repository_bundle",
        "multi_document_bundle",
        "long_video_transcript",
        "agent_session_bundle"
      ],
      "min_quality": 0.42
    }
  },
  "pipelines": [
    {
      "pipeline_id": "jsonl_ingest_and_hash",
      "stages": [
        "load_jsonl",
        "normalize_payload",
        "hash_payload_and_artifacts",
        "validate_required_fields",
        "write_raw_postgresql_mirror"
      ],
      "outputs": [
        "jsonl/events/normalized.jsonl",
        "jsonl/manifests/artifact_hashes.jsonl"
      ]
    },
    {
      "pipeline_id": "curation_and_split",
      "stages": [
        "secret_redaction",
        "license_and_source_date_check",
        "dedupe",
        "contamination_scan",
        "modality_quality_score",
        "split_assignment"
      ],
      "outputs": [
        "jsonl/curated/train.jsonl",
        "jsonl/curated/validation.jsonl",
        "jsonl/curated/quarantine.jsonl"
      ]
    },
    {
      "pipeline_id": "distillation_jobs",
      "stages": [
        "teacher_selection",
        "prompt_pack",
        "teacher_inference",
        "critique_parse",
        "preference_pair_build",
        "verifier_label_build"
      ],
      "outputs": [
        "jsonl/distillation/jobs.jsonl",
        "jsonl/distillation/responses.jsonl",
        "jsonl/distillation/preference_pairs.jsonl"
      ]
    },
    {
      "pipeline_id": "training_and_q4_recovery",
      "stages": [
        "sft",
        "multimodal_distillation",
        "long_context_retention",
        "preference_optimization",
        "q4_fake_quant_recovery",
        "q4_export_validation"
      ],
      "outputs": [
        "artifacts/checkpoints",
        "artifacts/q4_recovered",
        "jsonl/training/loss_samples.jsonl"
      ]
    },
    {
      "pipeline_id": "benchmark_gate_release",
      "stages": [
        "smoke_benchmarks",
        "loss_trend_checks",
        "artifact_hash_gate",
        "nightly_benchmarks",
        "release_benchmarks",
        "promotion_decision"
      ],
      "outputs": [
        "jsonl/evals/benchmark_results.jsonl",
        "jsonl/evals/gate_decisions.jsonl"
      ]
    }
  ],
  "curation_policy": {
    "require_2025_2026_source_dates": true,
    "reject_missing_source_date_unless_internal_trace": true,
    "allowed_splits": [
      "train",
      "validation",
      "eval_holdout",
      "quarantine",
      "rejected"
    ],
    "contamination": {
      "protected_path": "data/protected/eval_holdout_2026.jsonl",
      "threshold": 0.42,
      "ngram": 5,
      "quarantine_successful_eval_trajectories": true
    },
    "dedupe": {
      "payload_sha256": true,
      "artifact_sha256": true,
      "near_duplicate_trigram": true,
      "canonicalize_tool_traces": true
    },
    "secret_redaction": {
      "enabled": true,
      "reject_unredacted_secret_hits": true,
      "store_secret_hash_only": true
    }
  },
  "distillation": {
    "teacher_profile": "profiles/distillation_curriculum_2026.json",
    "teacher_job_types": [
      "trace_critique",
      "tool_repair",
      "tool_call_ast_label",
      "tool_state_delta_label",
      "code_patch_review",
      "reasoning_rewrite",
      "preference_pair",
      "reward_label",
      "verifier_label",
      "multimodal_alignment",
      "image_critique",
      "video_sync_critique",
      "audio_critique",
      "music_reward_label",
      "long_context_compression"
