    "primary": "jsonl",
    "mirror": "raw_postgresql",
    "schema": "schemas/training_orchestration_2026.sql",
    "mirror_mode": "optional_append_only_events_plus_current_state",
    "forbidden": [
      "orm",
      "pydantic",
      "sqlalchemy",
      "sqlite",
      "chroma"
    ]
  },
  "work_dir": "weights/training_orchestration_2026",
  "container_runtime": {
    "required_mounts": [
      {
        "host": "/home/cereal/omnicoder_2026_work",
        "container": "/workspace",
        "mode": "rw",
        "reason": "Repository, curated JSONL, checkpoints, logs, and run outputs."
      },
      {
        "host": "/home/cereal",
        "container": "/home/cereal",
        "mode": "ro",
        "reason": "Curated media artifact refs use host absolute /home/cereal paths; without this mount image/video/audio/music rows are rejected as inaccessible."
      }
    ],
    "media_artifact_visibility_gate": "curate-real must report nonzero train records for image, video, audio, and music before run-real is accepted as all-modality training"
  },
  "model_contract": {
    "target_profile": "omnicoder2026_20b_1m",
    "target_parameter_class": "20B-class dense, exact size governed by q4 24GB native-1M budget",
    "target_context_length": 1048576,
    "target_quantization": "q4 with TurboQuant/compressed native state",
    "budget_profile": "omnicoder2026_20b_1m",
    "training_verifier_preset": "ledger_probe",
    "training_verifier_role": "small full-ledger AI-server learning gate; never presented as the production-size target",
    "target_training_role": "run-full now resolves to the 20B/1M contract unless --allow-verifier-preset is passed explicitly"
  },
